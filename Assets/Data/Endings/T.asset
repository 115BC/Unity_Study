  id: 1
  title: "T \xB7 \u8D4E\u56DE"
  epilogueLines:
  - "\u5F71\u602A\u4F4E\u5934\u770B\u7740\u7BB1\u5B50,\u50CF\u5728\u770B\u4E00\u4EFD\u5F88\u4E45\u4EE5\u524D\u7684\u501F\u636E\u3002"
  - "\u4F60\u6D3B\u4E0B\u6765\u4E86\u3002\u8FD9\u4E00\u6B21,\u4F60\u662F\u4E3A\u81EA\u5DF1\u800C\u6D3B\u3002\u4F60\u53D1\u8A93\u518D\u4E5F\u4E0D\u53BB\u5BFB\u5B9D\u4E86\u3002"
  epilogueIfTrueClaimed:
  - "\u4F60\u6D3B\u4E0B\u6765\u4E86\u3002\u8FD9\u4E00\u6B21,\u4F60\u662F\u4E3A\u81EA\u5DF1\u800C\u6D3B\u3002\u4F60\u53D1\u8A93\u518D\u4E5F\u4E0D\u53BB\u5BFB\u5B9D\u4E86\u3002"
  - "\u4F60\u53C8\u4E00\u6B21\u4E0A\u4E86\u90A3\u67B6\u98DE\u673A\u3002\u8FD9\u4E00\u6B21,\u4F60\u77E5\u9053\u81EA\u5DF1\u5728\u66FF\u8C01\u6570\u94B1\u3002"
  usesClaimedEpilogue: 1
