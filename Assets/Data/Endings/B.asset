  id: 3
  title: "B \xB7 \u4E94\u5341\u5929"
  epilogueLines:
  - "\u7B2C\u4E94\u5341\u5929\u7684\u65E5\u51FA\u7167\u5E38\u5347\u8D77\u3002\u4F60\u5DF2\u7ECF\u4E0D\u518D\u6570\u65E5\u5B50\u4E86\u3002"
  - "\u4F60\u6D3B\u4E0B\u6765\u4E86,\u4F46\u5185\u5FC3\u4F9D\u65E7\u4E0D\u5B89\u3002\u51E0\u4E2A\u6708\u540E,\u4F60\u518D\u4E00\u6B21\u8E0F\u4E0A\u4E86\u5BFB\u5B9D\u7684\u65C5\u7A0B\u3002"
  epilogueIfTrueClaimed:
  - "\u7B2C\u4E94\u5341\u5929\u7684\u65E5\u51FA\u7167\u5E38\u5347\u8D77\u3002\u4F60\u5DF2\u7ECF\u4E0D\u518D\u6570\u65E5\u5B50\u4E86\u3002"
  - "\u4F60\u53C8\u4E00\u6B21\u4E0A\u4E86\u90A3\u67B6\u98DE\u673A\u3002\u8FD9\u4E00\u6B21,\u4F60\u77E5\u9053\u81EA\u5DF1\u5728\u66FF\u8C01\u6570\u94B1\u3002"
  usesClaimedEpilogue: 1
